#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

printf 'Running TrailBuiltOverland product/category image validation before push...\n'
python3.11 scripts/prepush_validate_images.py
printf 'Running TrailBuiltOverland content-repair validation before push...\n'
python3.11 scripts/validate-content-repairs.py
printf 'Running TrailBuiltOverland article chrome validation before push...\n'
python3.11 scripts/normalize-article-chrome.py --check
